\@writefile{toc}{\contentsline {subsection}{\numberline {6.4}Per-mode Pareto fronts: visualising the piecewise sub-manifolds}{18}{subsection.6.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Per-mode Pareto fronts recovered by BAMOR and Uniform across 5 seeds, grouping all weights in the evaluation grid. Each mode exhibits a distinct geometric substrate: Mode\nobreakspace  {}0's achievable front is a near-horizontal arc (progress collapsed), Mode\nobreakspace  {}1's is near-vertical (safety collapsed), and Mode\nobreakspace  {}2 is a full elbow. BAMOR's samples cluster along each arc (narrow scatter), while Uniform's fan out into the physically-unreachable interior (training waste). These are exactly the ``piecewise local Pareto sub-manifolds'' of §\ref  {sec:framework}.\relax }}{19}{figure.caption.2}\protected@file@percent }
\newlabel{fig:pareto_permode}{{1}{19}{Per-mode Pareto fronts recovered by BAMOR and Uniform across 5 seeds, grouping all weights in the evaluation grid. Each mode exhibits a distinct geometric substrate: Mode~0's achievable front is a near-horizontal arc (progress collapsed), Mode~1's is near-vertical (safety collapsed), and Mode~2 is a full elbow. BAMOR's samples cluster along each arc (narrow scatter), while Uniform's fan out into the physically-unreachable interior (training waste). These are exactly the ``piecewise local Pareto sub-manifolds'' of §\ref {sec:framework}.\relax }{figure.caption.2}{}}
